{
  "name": "cdk-workshop",
  "version": "0.1.0",
  "scripts": {
    "postinstall": "bash ./build-sharp-layer.sh",
    "dev": "concurrently -c gray,yellow,green npm:api:watch npm:api:serve npm:web:serve --kill-others-on-fail",
    "build": "npm run api:build && npm run web:build",
    "api:build": "trash dist/api && webpack --config lib/webpack.api.js",
    "api:watch": "npm run api:build -- --watch --progress",
    "api:serve": "sls dynamodb install && sls offline start",
    "web:build": "trash dist/web && ng build --configuration production",
    "web:serve": "ng serve"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.16",
    "@angular/animations": "^20.3.16",
    "@angular/cdk": "^20.2.14",
    "@angular/cli": "^20.3.16",
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/compiler-cli": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/forms": "^20.3.16",
    "@angular/language-service": "^20.3.16",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.16",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@types/app-root-path": "^1.2.4",
    "@types/aws-lambda": "^8.10.85",
    "@types/node": "^12.11.1",
    "@types/sharp": "^0.23.1",
    "@types/uuid": "^3.4.5",
    "aws-cdk": "^2.172.0",
    "concurrently": "^5.0.0",
    "serverless": "^2.64.1",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-offline": "^8.2.0",
    "serverless-s3-local": "^0.6.20",
    "trash-cli": "^3.0.0",
    "ts-loader": "^6.2.0",
    "ts-node": "^8.1.0",
    "typescript": "5.9",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.709.0",
    "@aws-sdk/client-iam": "^3.709.0",
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/lib-dynamodb": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "@ngxs/store": "^18.1.6",
    "app-root-path": "^2.2.1",
    "aws-cdk-lib": "^2.172.0",
    "aws-lambda": "^1.0.6",
    "cfn-response": "^1.0.1",
    "constructs": "^10.0.0",
    "leaflet": "^1.5.1",
    "lodash.isequal": "^4.5.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "source-map-support": "^0.5.9",
    "tslib": "^2.0.0",
    "uuid": "^3.3.3",
    "zone.js": "~0.15.1"
  }
}
